          "http": {
            "method": "DELETE",
            "url": "https://api.dnsimple.com/v2/:account/domains/:domain",
            "params": [
              {
                "name": "account",
                "value": "",
                "type": "path"
              },
              {
                "name": "domain",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Delete domain"
        }
      ]
    }
