{
  "opencollection": "1.0.0",
  "info": {
    "name": "DNSimple Accounts Certificates API",
    "version": "2"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Certificates",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List certificates",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.dnsimple.com/v2/:account/certificates",
            "params": [
              {
                "name": "account",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "List certificates"
        }
      ]
    }
  ],
  "bundled": true
}